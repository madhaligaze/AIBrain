<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp"
    android:background="@color/space_deep">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@color/white_alpha_20" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Результат расчёта"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="14dp" />

    <!-- Safety hero card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/space_light"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/white_alpha_10"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="БЕЗОПАСНОСТЬ"
                android:textColor="@color/text_white_dim"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_safety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/cyan_primary"
                android:textStyle="bold"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_physics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_white_medium"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_white_dim"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Critique / notes -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Заключение"
        android:textColor="@color/text_white_dim"
        android:textSize="12sp"
        android:letterSpacing="0.02"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tv_critique"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/text_white_medium"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="18dp" />

    <!-- Secondary actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_report"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Копировать отчёт" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_glb"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Экспорт GLB" />
    </LinearLayout>

    <!-- Primary action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_scan"
        style="@style/BtnPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Новое сканирование" />

</LinearLayout>
