<?xml version="1.0" encoding="utf-8"?>
<!--
═══════════════════════════════════════════════════════════════════════
  Engineering palette (calm, professional, dark). Replaces the previous
  neon "sci-fi HUD" look. Colour NAMES are unchanged so all layouts keep
  working; only the values changed.
  Accent = steel blue (informational), amber (actions), sage (success),
  muted red (danger). Surfaces = neutral cool-dark greys.
═══════════════════════════════════════════════════════════════════════
-->
