<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Calm engineering buttons (Material 3 palette). No neon tints, lighter
         weight, modest letter-spacing, moderate corner radius. -->
    <style name="BtnBase" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Primary action: amber filled -->
    <style name="BtnPrimary" parent="BtnBase">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="android:textColor">@color/space_deepest</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Informational primary: steel-blue filled -->
    <style name="BtnCyan" parent="BtnBase">
        <item name="backgroundTint">@color/cyan_primary</item>
        <item name="android:textColor">@color/space_deepest</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Secondary: tonal steel-blue with thin outline -->
    <style name="BtnSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/button_secondary_bg</item>
        <item name="android:textColor">@color/cyan_primary</item>
        <item name="strokeColor">@color/cyan_primary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Ghost: very subtle filled -->
    <style name="BtnGhost" parent="BtnBase">
        <item name="backgroundTint">@color/white_alpha_10</item>
        <item name="android:textColor">@color/text_white_medium</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Chip: small pill -->
    <style name="BtnChip" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/white_alpha_10</item>
        <item name="android:textColor">@color/text_white_medium</item>
        <item name="strokeColor">@color/white_alpha_20</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
